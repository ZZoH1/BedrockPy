pack:
    name = "test pack"
    description = "테스트용 행동 팩"
    # icon = "assets/pack_icon.png"
    version = auto
    min_engine_version = [1, 21, 0]

    namespace = "test"
    output = "build/testBP"
    mcpack = true
    # max_lines = 10000

vars:
    let target = "@e[type=chicken]"
    float value = 1.5
    float sqrt_value = 1
    float x = 0.0
    float y = 0.0
    float z = 0.0
    float rx = 0.0
    float ry = 0.0
    float alignX = 0.0
    float alignZ = 0.0
    bool repeating = false

init:
    call hello
    # /execute as @a at @s run summon armor_stand

tick:
    positioned 0 0 0:
        if entity @a[r=2]:
            repeating = false
            call exist
            call out
            value *= 1.1
            sqrt_value = sqrt(value)
            actionbar @a, value:4, " ", sqrt_value:4
        else:
            repeating = true

function cal_pos:
    location @p -> x, y, z
    rotation @p -> rx, ry
    actionbar @a, x:1, " ", y:1, " ", z:1, " ", rx:1, " ", ry:1
    # alignX = x+0.5
    # alignZ = z+0.5
    tp target -> x, y, z
    sleep(20)
    if repeating:
        call cal_pos
        

function exist when first:
    tell @a, "플레이어가 침입했습니다."
    value = 1.5
    call message

function out when last:
    tell @a, "플레이어가 떠났습니다."
    call cal_pos

function hello:
    tell @a, "테스트 팩이 로드되었습니다."

function message:
    tell @a, "안녕하세요, 저희는 중요한 사람입니다"
    sleep(20)
    tell @a, "어떤 삶을 살아야 할지 예상이 되시나요?"
    sleep(20)
    tell @a, "꼭 그렇게 살지 않으셔도 됩니다."