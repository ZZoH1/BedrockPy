vars:
    let target_block = "stone"
    let goal_block = "diamond_block"

tick:
    as @e[name="감염 생성"] at @s:
        /summon armor_stand ~ ~999 ~
        positioned ~ ~999 ~:
            /tag @e[type=armor_stand,name=!"감염 생성",tag=!감염블록,c=1] add 감염블록
        /kill @s
    
    as @e[tag="감염블록"] at @s:
        /tp @s ~ ~ ~
    
    if entity @e[tag="감염블록", c=1] as @e[tag="감염블록", c=1] at @s:
        positioned ~ ~-1000 ~:
            /setblock ~ ~ ~ {goal_block}
            if block ~1 ~ ~ {target_block}:
                /setblock ~1 ~ ~ {goal_block}
                /summon armor_stand ~1 ~1000 ~
                positioned ~1 ~1000 ~:
                    /tag @e[type=armor_stand,name=!"감염 생성",tag=!감염블록,c=1] add 감염블록
            if block ~-1 ~ ~ {target_block}:
                /setblock ~-1 ~ ~ {goal_block}
                /summon armor_stand ~-1 ~1000 ~
                positioned ~-1 ~1000 ~:
                    /tag @e[type=armor_stand,name=!"감염 생성",tag=!감염블록,c=1] add 감염블록
            if block ~ ~ ~1 {target_block}:
                /setblock ~ ~ ~1 {goal_block}
                /summon armor_stand ~ ~1000 ~1
                positioned ~ ~1000 ~1:
                    /tag @e[type=armor_stand,name=!"감염 생성",tag=!감염블록,c=1] add 감염블록
            if block ~ ~ ~-1 {target_block}:
                /setblock ~ ~ ~-1 {goal_block}
                /summon armor_stand ~ ~1000 ~-1
                positioned ~ ~1000 ~-1:
                    /tag @e[type=armor_stand,name=!"감염 생성",tag=!감염블록,c=1] add 감염블록
            if block ~ ~1 ~ {target_block}:
                /setblock ~ ~1 ~ {goal_block}
                /summon armor_stand ~ ~1001 ~
                positioned ~ ~1001 ~:
                    /tag @e[type=armor_stand,name=!"감염 생성",tag=!감염블록,c=1] add 감염블록
            if block ~ ~-1 ~ {target_block}:
                /setblock ~ ~-1 ~ {goal_block}
                /summon armor_stand ~ ~999 ~
                positioned ~ ~999 ~:
                    /tag @e[type=armor_stand,name=!"감염 생성",tag=!감염블록,c=1] add 감염블록
        /kill @s
